# 复制成 .env.local 后填写。.env.local 已被 .gitignore 忽略，绝对不要提交。
# 值在 Supabase Dashboard → Project Settings → API 里拿。

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 服务端用于签名短时 OTP 验证上下文。请用密码生成器创建至少 32 个随机字符，绝不能加 NEXT_PUBLIC_ 前缀。
EMAIL_OTP_CONTEXT_SECRET=replace-with-at-least-32-random-characters

# 站点地址，用于邮箱验证的回调链接。本地保持 localhost，Vercel 上留空即可（自动用 VERCEL_URL）。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ⚠️ service_role key 绕过所有 RLS。不要放进这个项目，不要给它 NEXT_PUBLIC_ 前缀，
#    也不要交给协作者。需要用到时单独在 Vercel 环境变量里配。
