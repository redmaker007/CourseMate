# 复制成 .env.local 后填写。.env.local 已被 .gitignore 忽略，绝对不要提交。
# 值在 Supabase Dashboard → Project Settings → API 里拿。

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# 服务端用于签名短时 OTP 验证上下文。请用密码生成器创建至少 32 个随机字符，绝不能加 NEXT_PUBLIC_ 前缀。
EMAIL_OTP_CONTEXT_SECRET=replace-with-at-least-32-random-characters

# 站点地址，用于邮箱验证的回调链接。本地保持 localhost，Vercel 上留空即可（自动用 VERCEL_URL）。
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase Auth 的 SMTP 适配层。切换免费或付费邮件服务商时只替换这些值，
# 不需要修改验证码请求、验证或成员绑定代码。不要在此文件填写真实凭据。
SUPABASE_AUTH_SMTP_HOST=smtp.provider.example
SUPABASE_AUTH_SMTP_USER=replace-with-smtp-user
SUPABASE_AUTH_SMTP_PASS=replace-with-smtp-password
SUPABASE_AUTH_SMTP_ADMIN_EMAIL=no-reply@example.com
SUPABASE_AUTH_SMTP_SENDER_NAME=CourseMate

# ⚠️ service_role key 绕过所有 RLS：不要给它 NEXT_PUBLIC_ 前缀，也不要交给协作者，只在 Vercel 环境变量里配（见下面推送一节）。

# 网页推送（可选，四项齐全才开启）。VAPID 密钥用 npx web-push generate-vapid-keys 生成，
# VAPID_SUBJECT 是 mailto:你的联系邮箱。这些只在 Vercel 环境变量里配，都不要加 NEXT_PUBLIC_ 前缀；
# SUPABASE_SERVICE_ROLE_KEY 只用于推送发送器调用受限函数，见 docs/adr/0010。
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@example.com
SUPABASE_SERVICE_ROLE_KEY=
